# CareEcho Backend Environment Configuration
# NO EMAIL VARIABLES PERMITTED

PORT=5050
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=careecho-super-secret-jwt-token-key-2026-secure
REFRESH_SECRET=careecho-super-secret-refresh-token-key-2026-secure

# PostgreSQL Database (Optional - application runs out-of-the-box with embedded store if unset)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careecho_db
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=careecho_db
